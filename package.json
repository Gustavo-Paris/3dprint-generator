{
  "name": "3dprint-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "meshes:sweep": "tsx --env-file=.env.local scripts/sweep-orphan-meshes.ts",
    "meshes:sweep:apply": "tsx --env-file=.env.local scripts/sweep-orphan-meshes.ts --apply"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@auth/drizzle-adapter": "^1.11.2",
    "@jscad/modeling": "^2.13.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.183",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "postgres": "^3.4.9",
    "potrace": "^2.1.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "phin@<3.7.1": ">=3.7.1"
    }
  }
}
