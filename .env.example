# ─────────────────────────────────────────────────────────────────────────────
# Gerador 3D — environment.  Copy to .env.local and fill in.
#
# NOTE: AI + Meshy + Slicer can ALSO be configured from the in-app Settings page
# (⚙ Configurações), which stores them encrypted in the DB and OVERRIDES these
# env vars. A fresh self-host can run on env only; the UI is just a convenience.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgres://app:app@localhost:5432/app"

# NextAuth (Auth.js v5). AUTH_SECRET also derives the key used to encrypt the
# API keys stored via the Settings page — rotating it invalidates stored secrets.
AUTH_SECRET=""
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="auth@yourdomain.com"
AUTH_ALLOWED_EMAILS=""           # comma-separated sign-in allowlist
ADMIN_EMAIL=""                   # may change Settings (defaults to first AUTH_ALLOWED_EMAILS entry)
# AUTH_URL="https://your-domain.com"   # REQUIRED in production (canonical origin)

# ── AI provider — bring your own (OpenAI-compatible) ─────────────────────────
# Works with OpenAI, OpenRouter, Together, Groq, and local Ollama/LM Studio.
AI_BASE_URL=""                   # e.g. https://api.openai.com/v1
AI_API_KEY=""
AI_MODEL=""                      # e.g. gpt-4o-mini
AI_CLASSIFIER_MODEL=""           # optional; defaults to AI_MODEL

# Legacy/alternate AI paths (used only if AI_BASE_URL + AI_MODEL are unset):
AI_GATEWAY_API_KEY=""            # Vercel AI Gateway
ANTHROPIC_API_KEY=""             # direct Anthropic

# ── Meshy.ai — optional, enables freeform organic shapes ─────────────────────
# Without it, organic requests collapse to the closest parametric primitive.
MESHY_API_KEY=""

# ── Slicer microservice (OrcaSlicer) — optional ──────────────────────────────
SLICER_URL="http://localhost:8787"

# ── Optional Vercel Blob for storing sliced 3MFs ─────────────────────────────
# If absent, /api/slice returns the 3MF bytes inline (base64).
BLOB_READ_WRITE_TOKEN=""

# ── DEV ONLY — never set in production. Enables a test-login bypass for E2E. ──
E2E_ALLOW_TEST_LOGIN=""
