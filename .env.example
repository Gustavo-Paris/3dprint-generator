# Database
DATABASE_URL="postgres://app:app@localhost:5432/app"

# NextAuth (Auth.js v5)
AUTH_SECRET=""
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="auth@yourdomain.com"
AUTH_ALLOWED_EMAILS=""

# AI Gateway (preferred) OR direct Anthropic
AI_GATEWAY_API_KEY=""
ANTHROPIC_API_KEY=""

# Meshy.ai — text/image-to-3D for freeform organic shapes (animals, characters).
# Optional: when absent, the LLM never routes to freeform and collapses organic
# requests to the closest parametric primitive. Get a key at https://meshy.ai.
MESHY_API_KEY=""

# E2E only — DEV ONLY. Enables a credentials provider that bypasses email auth.
# NEVER set this in production.
E2E_ALLOW_TEST_LOGIN=""

# Slicer microservice (Phase 4) — defaults to localhost (docker-compose)
SLICER_URL="http://localhost:8787"

# Optional Vercel Blob token for storing sliced 3MFs. If absent, /api/slice
# returns the 3MF bytes inline (base64) so the client can download directly.
BLOB_READ_WRITE_TOKEN=""
