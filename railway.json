{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "preDeployCommand": "node scripts/migrate.mjs",
    "startCommand": "mkdir -p /data/uploads /data/meshes && MESH_STORAGE_DIR=/data/meshes UPLOAD_STORAGE_DIR=/data/uploads pnpm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
